<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="420.0" prefHeight="240.0">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <top>
        <Label text="Bienvenue dans le monde FXML !"
               BorderPane.alignment="CENTER">
            <font>
                <Font size="20"/>
            </font>
            <style>-fx-font-weight: bold;</style>
        </Label>
    </top>

    <center>
        <Label text="FXML est un langage déclaratif basé sur XML qui permet de construire des interfaces JavaFX sans écrire de code Java."
               wrapText="true"
               BorderPane.alignment="CENTER"/>
    </center>

    <bottom>
        <Button text="D'accord, c'est magique"
                BorderPane.alignment="CENTER"/>
    </bottom>

</BorderPane>